---
layout: base.njk
---
<article class="article">
  <div class="narrow">
    <a class="back" href="/blog/">← Voltar ao blog</a>
    <div class="tag">{{ categoria }}</div>
    <h1>{{ title }}</h1>
    <div class="meta">{{ site.nome }} · {{ page.date | dataBR }} · {{ content | tempoLeitura }} min de leitura</div>

    <div class="content">
{{ content | safe }}
    </div>

    {% if referencias %}<div class="refs"><b>Para quem quer se aprofundar:</b> {{ referencias }}</div>{% endif %}

    <div class="end">
      <h3>Sente que a pressão está cobrando um preço?</h3>
      <p>A gente pode conversar sobre isso.</p>
      <a class="btn" href="/#contato">Quero conversar</a>
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ resumo | dump | safe }},
  "datePublished": "{{ page.date | dataISO }}",
  "inLanguage": "pt-BR",
  "mainEntityOfPage": "{{ page.url | absoluta(site) }}",
  "image": "{{ '/img/compartilhar.jpg' | absoluta(site) }}",
  "author": {"@type": "Person", "name": "{{ site.nome }}", "jobTitle": "Psicóloga", "url": "{{ '/' | absoluta(site) }}"}
}
</script>
