---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.data.rascunho and not p.data.em_breve %}
  <url><loc>{{ p.url | absoluta(site) }}</loc><lastmod>{{ p.date | dataISO }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
